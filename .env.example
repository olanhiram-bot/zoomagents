# Opción A: deja las keys aquí (se leen del entorno, nunca llegan al navegador).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Opción B: pégalas desde la UI → Ajustes. Se guardan en data/settings.json.

# Puerto del servidor (por defecto 8787).
PORT=8787

# Opcional: forzar el modelo que se pasa a cada CLI.
# ZA_CLAUDE_MODEL=sonnet
# ZA_CODEX_MODEL=gpt-5.1-codex
# ZA_GEMINI_MODEL=gemini-2.5-pro
# ZA_OPENCODE_MODEL=opencode/big-pickle
